# Contatos vigiados (separados por virgula) ou "*" para monitorar todos os contatos individuais.
# Aceita formatos com pontuacao (+55 21 99999-9999) ou apenas digitos (5521999999999).
ALLOWED_JIDS=*

# Lista opcional de contatos isentos (excecoes autorizadas a desativar mensagens temporarias sem punicao).
EXCLUDED_JIDS=5521999999999,5521888888888

# Duracao das mensagens temporarias ao reativar.
# Valores aceitos: 86400 (24h), 604800 (7 dias) ou 7776000 (90 dias).
EPHEMERAL_SECONDS=604800

# Intervalo minimo entre dois eventos do mesmo contato (em horas).
COOLDOWN_HOURS=24

# Delay aleatorio, em minutos, antes de reativar na 2a desativacao (a mensagem de aviso e instantanea).
MIN_DELAY_MINUTES=1
MAX_DELAY_MINUTES=3

# Opcional. Sem chave, o projeto usa mensagens fallback pre-definidas.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Endpoint compativel com OpenAI (proxy, gateway ou API local).
OPENAI_BASE_URL=https://api.openai.com/v1

# Timeout da chamada em milissegundos.
OPENAI_TIMEOUT_MS=8000

# Numero de retries em falhas transitorias.
OPENAI_MAX_RETRIES=0

# Temperatura da geracao (0 a 2) e limite de tokens da resposta.
OPENAI_TEMPERATURE=1.05
OPENAI_MAX_TOKENS=60

# Notificacoes no Telegram (opcional; envia alertas e auditoria em tempo real).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Nivel de log do pino: trace, debug, info, warn, error, silent.
LOG_LEVEL=info
